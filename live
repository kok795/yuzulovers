    }

    .live-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 25px;
    }

    .live-card {
      background: white;
      border-radius: 8px;
      overflow: hidden;
      box-shadow: 0 3px 15px rgba(0,0,0,.07);
      transition: transform .3s;
    }

    .live-card:hover {
      transform: translateY(-5px);
    }

    .live-card img {
      width: 100%;
      aspect-ratio: 16 / 9;
      object-fit: cover;
      background: #eee;
    }

    .live-info {
      padding: 20px;
    }

    .live-year {
      color: #b18435;
      font-size: 13px;
      letter-spacing: 2px;
    }

    .live-info h3 {
      font-size: 18px;
      margin: 10px 0;
    }

    .live-info p {
      font-size: 13px;
      color: #777;
      line-height: 1.8;
    }

    .history {
      position: relative;
      max-width: 850px;
      margin: auto;
    }

    .history::before {
      content: "";
      position: absolute;
      left: 95px;
      top: 0;
      bottom: 0;
      width: 2px;
      background: #d6a34a;
    }

    .history-item {
      display: grid;
      grid-template-columns: 80px 1fr;
      gap: 45px;
      margin-bottom: 35px;
      position: relative;
    }

    .history-year {
      color: #b18435;
      font-weight: bold;
      font-size: 22px;
      text-align: right;
    }

    .history-content {
      position: relative;
      background: #fff;
      padding: 20px;
      box-shadow: 0 3px 12px rgba(0,0,0,.06);
      border-radius: 8px;
    }

    .history-content::before {
      content: "";
      position: absolute;
      left: -48px;
      top: 10px;
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: #d6a34a;
      border: 4px solid white;
    }

    .history-content h3 {
      margin: 0 0 10px;
    }

    .history-content p {
      margin: 0;
      line-height: 1.9;
      color: #666;
      font-size: 14px;
    }

    .official-live {
      text-align: center;
      padding: 45px 20px;
      margin-top: 70px;
      background: #f8f5ef;
      border-radius: 10px;
    }

    .official-live a {
      display: inline-block;
      padding: 13px 28px;
      background: #b18435;
      color: white;
      text-decoration: none;
      border-radius: 25px;
      margin-top: 15px;
    }

    @media(max-width:600px) {
      .history::before {
        left: 65px;
      }

      .history-item {
        grid-template-columns: 55px 1fr;
        gap: 25px;
      }

      .history-year {
        font-size: 17px;
      }

      .history-content {
        padding: 15px;
      }
    }
